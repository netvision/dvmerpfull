# systemd service for the DVM API (uvicorn)
# Place at /etc/systemd/system/dvmapi.service
# Then: sudo systemctl daemon-reload
#       sudo systemctl enable dvmapi
#       sudo systemctl start dvmapi

[Unit]
Description=DVM ERP API (FastAPI/uvicorn)
After=network.target postgresql.service

[Service]
User=dev
Group=dev
WorkingDirectory=/home/dev/dvmerpfull/backend
EnvironmentFile=/home/dev/dvmerpfull/backend/.env
ExecStart=/home/dev/dvmerpfull/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dvmapi

[Install]
WantedBy=multi-user.target
