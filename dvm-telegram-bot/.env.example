# DVM ERP Telegram Bot — Environment Variables
# Copy this file to .env and fill in the values

# ── Telegram ────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated list of allowed Telegram user IDs (no spaces)
# Get your ID by messaging @userinfobot on Telegram
ALLOWED_TELEGRAM_IDS=123456789,987654321

# ── Gemini LLM ──────────────────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── DVM ERP Agent API ───────────────────────────────────────────────────────
# Base URL of the /api/agent/* endpoints (no trailing slash)
AGENT_BASE_URL=https://your-vps-domain/api/agent

# The API key set in the backend .env as AGENT_API_KEY
AGENT_API_KEY=your-agent-api-key-here
