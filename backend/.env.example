# Copy this file to .env and fill in real values before running the server.

# REQUIRED: cryptographically strong secret for signing JWTs
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection string (production)
# DATABASE_URL=postgresql://dvmuser:password@localhost/dvmdb
# Leave unset locally to fall back to SQLite
DATABASE_URL=

# Comma-separated list of allowed CORS origins (no trailing slashes)
# Production: https://dvmchirawa.ac.in (or your Netlify URL)
ALLOWED_ORIGINS=http://localhost:5173
